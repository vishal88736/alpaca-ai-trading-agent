# Copy this file to .env and fill in real values. Never commit .env.

# Alpaca — optional here. You can instead connect interactively via the
# website's Connect screen, in which case these are not required at startup.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Groq AI Orchestrator Settings
# Set your Groq API key (from https://console.groq.com) and desired model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Session/cookie signing secret — set a real random value in any shared deployment.
SESSION_SECRET=

LOG_LEVEL=INFO
