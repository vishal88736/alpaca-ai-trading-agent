# Copy this file to .env and fill in real values. Never commit .env.

# Alpaca — optional here. You can instead connect interactively via the
# website's Connect screen, in which case these are not required at startup.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional third-party providers, used by model/orchestrator and
# backend/app/services/news_service.py once you implement them.
LLM_API_KEY=
NEWS_API_KEY=

# Session/cookie signing secret — set a real random value in any shared deployment.
SESSION_SECRET=

LOG_LEVEL=INFO
